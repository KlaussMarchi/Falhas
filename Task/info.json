{
    "network": "resaceunet_grva_2",
    "dataset": "dataset_zu",
    "img_size": null,
    "scaling": "normalize",
    "lr": 0.001,
    "loss": "dice_ce",
    "batch_size": 4,
    "scheduler": "cosine",
    "dropout": 0.0,
    "num_filters": 16,
    "ema": false,
    "amp": true,
    "epochs": 200,
    "patience": 200,
    "n_trials": 1,
    "augmentations": {
        "n_aug": 1,
        "contrast": {
            "prob": 0.2,
            "gamma": [
                0.9,
                1.1
            ]
        },
        "rotate90": {
            "prob": 0.2,
            "axes": [
                0,
                2
            ]
        },
        "flip": {
            "prob": 0.2,
            "axes": [
                0,
                2
            ]
        },
        "rotate": {
            "prob": 0.2,
            "angle": 0.25,
            "planes": [
                [
                    1,
                    2
                ],
                [
                    0,
                    1
                ]
            ]
        },
        "smooth": {
            "prob": 0.1,
            "sigma": [
                0.25,
                1.5
            ]
        },
        "noise": {
            "prob": 0.2,
            "std": 0.03
        },
        "crop": {
            "size": [
                96,
                96,
                96
            ],
            "pos": 1,
            "neg": 1,
            "overlap": 0.5,
            "mode": "gaussian"
        }
    },
    "trial": 0
}